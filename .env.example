# Frontend env (Vite). VITE_* values are PUBLIC — they ship in the browser bundle.
# Never put a service_role key or any secret in a VITE_ variable.

# Supabase project URL and the *anon* (public) key — Dashboard → Settings → API.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Server-side secrets are NOT set here. Edge functions read theirs from
# `supabase secrets set` (GEMINI_API_KEY, CRON_SECRET, FRONTEND_URL, ...);
# Vercel deployment env vars are configured in the Vercel dashboard.
